{
  "name": "@deepseek-ai/dsh-agent-plane",
  "description": "The shared agent-plane bundle: preset registry and declarations, applied by the web surface and the session worker",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/agent-plane"
  },
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets/standard.patch.yml",
    "presets/ptc.patch.yml",
    "presets/minimal.patch.yml",
    "presets/cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-agent-tool-presentation": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-command-goal": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-file-reference-local": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-plan-mode": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-plugin-market": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-terminal": "workspace:*",
    "@deepseek-ai/dsh-terminal-bash": "workspace:*",
    "@deepseek-ai/dsh-time-context": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-bash-persistent": "workspace:*",
    "@deepseek-ai/dsh-tool-cordis": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "workspace:*",
    "@deepseek-ai/dsh-tool-schedule": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-tool-workflow": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
